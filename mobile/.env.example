# Copy to `.env` (same folder) and fill in. EXPO_PUBLIC_* values end up in the
# app bundle, so only public keys belong here — never the service_role key.

# Supabase → Project Settings → API → "anon public" (or "publishable") key.
# It's the same value as NEXT_PUBLIC_SUPABASE_ANON_KEY in the craveit-nextjs
# project on Vercel. Without it the app works through Base44 (slower).
EXPO_PUBLIC_SUPABASE_URL=https://dcpqgxlgiitrdozkykbq.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

EXPO_PUBLIC_BASE44_APP_ID=69eb2d67d2208986b7d60a5d
EXPO_PUBLIC_BASE44_APP_BASE_URL=https://crave-it-delivery.base44.app
