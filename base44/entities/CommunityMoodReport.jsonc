{
  "name": "CommunityMoodReport",
  "type": "object",
  "properties": {
    "proposal_id": {
      "type": "string",
      "title": "CommunityMoodProposal id"
    },
    "reporter_user_id": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "enum": [
        "spam",
        "inappropriate",
        "misleading",
        "other"
      ],
      "default": "other"
    },
    "details": {
      "type": "string",
      "title": "Additional details"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "reviewed",
        "dismissed"
      ],
      "default": "pending"
    },
    "reviewed_by": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "proposal_id",
    "reporter_user_id",
    "reason"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}