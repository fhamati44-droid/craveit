{
  "name": "LoyaltyAccount",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "title": "Base44 user id (optional)"
    },
    "phone": {
      "type": "string",
      "title": "\u0631\u0642\u0645 \u0627\u0644\u0647\u0627\u062a\u0641 (\u0645\u0641\u062a\u0627\u062d \u0627\u0644\u0639\u0645\u064a\u0644)"
    },
    "balance": {
      "type": "number",
      "default": 0,
      "title": "\u0627\u0644\u0631\u0635\u064a\u062f \u0627\u0644\u0645\u062a\u0627\u062d"
    },
    "pending_balance": {
      "type": "number",
      "default": 0,
      "title": "\u0646\u0642\u0627\u0637 \u0642\u064a\u062f \u0627\u0644\u062a\u0623\u0643\u064a\u062f"
    },
    "used_points": {
      "type": "number",
      "default": 0,
      "title": "\u0646\u0642\u0627\u0637 \u0645\u0633\u062a\u062e\u062f\u0645\u0629"
    },
    "expired_points": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "phone"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}