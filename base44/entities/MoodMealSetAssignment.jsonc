{
  "name": "MoodMealSetAssignment",
  "type": "object",
  "properties": {
    "mood_id": {
      "type": "string",
      "title": "TamamMood id"
    },
    "meal_set_id": {
      "type": "string",
      "title": "MealSet id"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "display_priority": {
      "type": "number",
      "default": 0
    },
    "recommendation_weight": {
      "type": "number",
      "default": 0
    },
    "available_from": {
      "type": "string",
      "format": "date-time"
    },
    "available_until": {
      "type": "string",
      "format": "date-time"
    },
    "available_days": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "time_window_start": {
      "type": "string",
      "title": "HH:MM"
    },
    "time_window_end": {
      "type": "string",
      "title": "HH:MM"
    },
    "default_tier": {
      "type": "string",
      "enum": [
        "classic",
        "mix",
        "plus"
      ]
    },
    "featured_for_mood": {
      "type": "boolean",
      "default": false
    },
    "internal_notes": {
      "type": "string"
    },
    "vertical_id": {
      "type": "string",
      "title": "MenuVertical id \u2014 mood matching considers business type, not only mood name"
    },
    "daypart_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "BREAKFAST / LUNCH / DINNER / \u2026 \u2014 time context for this assignment"
    },
    "day_of_week": {
      "type": "number",
      "title": "0=Sun \u2026 6=Sat; null = any day"
    },
    "audience_size_min": {
      "type": "number"
    },
    "audience_size_max": {
      "type": "number"
    },
    "weather_contexts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "hot / cold / rainy / \u2026"
    },
    "priority": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "mood_id",
    "meal_set_id"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}