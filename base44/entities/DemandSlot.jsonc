{
  "name": "DemandSlot",
  "type": "object",
  "properties": {
    "weekly_demand_profile_id": {
      "type": "string"
    },
    "restaurant_id": {
      "type": "string"
    },
    "branch_id": {
      "type": "string"
    },
    "day_of_week": {
      "type": "number",
      "title": "0=Sun \u2026 6=Sat"
    },
    "start_time": {
      "type": "string",
      "title": "HH:MM"
    },
    "end_time": {
      "type": "string",
      "title": "HH:MM"
    },
    "demand_level": {
      "type": "string",
      "enum": [
        "quiet",
        "medium",
        "busy",
        "unknown"
      ],
      "default": "unknown"
    },
    "source": {
      "type": "string",
      "enum": [
        "merchant",
        "restaurant_manager",
        "tamam_admin",
        "analytics_suggestion"
      ],
      "default": "merchant"
    },
    "is_recurring": {
      "type": "boolean",
      "default": true
    },
    "effective_from": {
      "type": "string",
      "format": "date-time"
    },
    "effective_until": {
      "type": "string",
      "format": "date-time"
    },
    "note": {
      "type": "string"
    },
    "is_demo": {
      "type": "boolean",
      "default": false,
      "title": "Demo record flag"
    },
    "demo_batch_id": {
      "type": "string",
      "title": "Demo batch id"
    }
  },
  "required": [
    "weekly_demand_profile_id",
    "restaurant_id",
    "day_of_week",
    "start_time",
    "end_time"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}