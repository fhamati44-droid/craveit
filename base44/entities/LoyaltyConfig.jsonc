{
  "name": "LoyaltyConfig",
  "type": "object",
  "properties": {
    "points_per_currency": {
      "type": "number",
      "default": 1,
      "title": "\u0646\u0642\u0637\u0629 \u0644\u0643\u0644 \u20aa \u0645\u0646 \u0642\u064a\u0645\u0629 \u0627\u0644\u0637\u0644\u0628"
    },
    "points_rounding": {
      "type": "string",
      "enum": [
        "floor",
        "round",
        "ceil"
      ],
      "default": "floor",
      "title": "\u062a\u0642\u0631\u064a\u0628 \u0627\u0644\u0646\u0642\u0627\u0637"
    },
    "eligible_event": {
      "type": "string",
      "enum": [
        "delivered",
        "paid"
      ],
      "default": "delivered",
      "title": "\u0627\u0644\u062d\u062f\u062b \u0627\u0644\u0645\u0624\u0647\u0644 \u0644\u0631\u0628\u062d \u0627\u0644\u0646\u0642\u0627\u0637"
    },
    "expiry_days": {
      "type": "number",
      "default": 180,
      "title": "\u0635\u0644\u0627\u062d\u064a\u0629 \u0627\u0644\u0646\u0642\u0627\u0637 (\u0623\u064a\u0627\u0645)"
    },
    "redeem_value_per_point": {
      "type": "number",
      "default": 1,
      "title": "\u0642\u064a\u0645\u0629 \u0627\u0644\u0627\u0633\u062a\u0628\u062f\u0627\u0644 \u0628\u0627\u0644\u0634\u064a\u0643\u0644 \u0644\u0643\u0644 \u0646\u0642\u0637\u0629"
    },
    "min_payable_fraction": {
      "type": "number",
      "default": 0.5,
      "title": "\u0623\u062f\u0646\u0649 \u0646\u0633\u0628\u0629 \u0645\u0646 \u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a \u062a\u0628\u0642\u0649 \u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u062f\u0641\u0639 \u0628\u0639\u062f \u0627\u0644\u062e\u0635\u0645"
    },
    "reward_coupon_enabled": {
      "type": "boolean",
      "default": true
    },
    "reward_coupon_value": {
      "type": "number",
      "default": 15,
      "title": "\u0642\u064a\u0645\u0629 \u0643\u0648\u0628\u0648\u0646 \u0627\u0644\u0645\u0643\u0627\u0641\u0623\u0629 (\u20aa)"
    },
    "reward_coupon_min_order": {
      "type": "number",
      "default": 50
    },
    "reward_coupon_expiry_days": {
      "type": "number",
      "default": 30
    }
  },
  "required": [
    "points_per_currency"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}