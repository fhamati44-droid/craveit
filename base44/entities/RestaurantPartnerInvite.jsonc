{
  "name": "RestaurantPartnerInvite",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "title": "Invited email (normalized lowercase)"
    },
    "restaurant_id": {
      "type": "string",
      "title": "Restaurant (Base44 id)"
    },
    "partner_role": {
      "type": "string",
      "enum": [
        "owner",
        "manager",
        "employee",
        "demo_reviewer"
      ],
      "title": "Partner role granted on claim"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Permissions copied into the membership on claim"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "revoked",
        "expired"
      ],
      "default": "pending"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "title": "Null = no expiry"
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time"
    },
    "accepted_user_id": {
      "type": "string",
      "title": "Base44 user id that claimed the invite"
    },
    "invited_by_user_id": {
      "type": "string",
      "title": "Admin user id that sent the invite"
    },
    "is_demo": {
      "type": "boolean",
      "default": false,
      "title": "Mirrors the target restaurant is_demo flag"
    }
  },
  "required": [
    "email",
    "restaurant_id",
    "partner_role"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}