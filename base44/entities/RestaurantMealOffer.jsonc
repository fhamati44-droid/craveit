{
  "name": "RestaurantMealOffer",
  "type": "object",
  "properties": {
    "restaurant_id": {
      "type": "string",
      "title": "Restaurant (Base44 id)"
    },
    "meal_id": {
      "type": "number",
      "title": "Supabase menu_item id (TAMAM master product mapping \u2014 backward-compat alias of mapped_tamam_product_id)"
    },
    "mapped_tamam_product_id": {
      "type": "number",
      "title": "Primary mapping key \u2192 TAMAM Master Product id (Supabase menu_items)"
    },
    "mapped_meal_set_id": {
      "type": "string",
      "title": "Optional: MealSet id when the product belongs to a MealSet"
    },
    "mapped_meal_set_variant_id": {
      "type": "string",
      "title": "Optional: MealSetVariant id (Classic / Mix / Plus)"
    },
    "mapped_tier": {
      "type": "string",
      "enum": [
        "classic",
        "mix",
        "plus"
      ],
      "title": "Tier (reference, derived from MealSetVariant)"
    },
    "meal_name_snapshot": {
      "type": "string",
      "title": "TAMAM meal name snapshot (human reference only)"
    },
    "menu_id": {
      "type": "number",
      "title": "Supabase menu/category id (optional)"
    },
    "category_id": {
      "type": "number",
      "title": "Supabase category id (optional)"
    },
    "category_name_snapshot": {
      "type": "string"
    },
    "package_id": {
      "type": "string",
      "title": "Classic / Mix / Plus (optional)"
    },
    "restaurant_product_name": {
      "type": "string"
    },
    "restaurant_sku": {
      "type": "string"
    },
    "price": {
      "type": "number",
      "title": "Actual restaurant price"
    },
    "compare_at_price": {
      "type": "number"
    },
    "restaurant_discount": {
      "type": "number",
      "default": 0
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "available": {
      "type": "boolean",
      "default": true
    },
    "available_quantity": {
      "type": "number"
    },
    "minimum_quantity": {
      "type": "number",
      "default": 1
    },
    "maximum_quantity": {
      "type": "number"
    },
    "preparation_time_override": {
      "type": "number"
    },
    "restaurant_notes": {
      "type": "string"
    },
    "included_items": {
      "type": "string"
    },
    "customer_visible_description": {
      "type": "string"
    },
    "image_override_url": {
      "type": "string"
    },
    "supports_classic": {
      "type": "boolean"
    },
    "supports_mix": {
      "type": "boolean"
    },
    "supports_plus": {
      "type": "boolean"
    },
    "restaurant_menu_id": {
      "type": "string",
      "title": "RestaurantMenu id"
    },
    "name_en": {
      "type": "string"
    },
    "short_description_ar": {
      "type": "string"
    },
    "full_description_ar": {
      "type": "string"
    },
    "ingredients_ar": {
      "type": "string"
    },
    "allergens_ar": {
      "type": "string"
    },
    "portion_description_ar": {
      "type": "string"
    },
    "packaging_description_ar": {
      "type": "string"
    },
    "dietary_labels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "primary_image": {
      "type": "string"
    },
    "gallery_images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "thumbnail_image": {
      "type": "string"
    },
    "image_alt_ar": {
      "type": "string"
    },
    "discount_amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "ILS"
    },
    "tax_included": {
      "type": "boolean",
      "default": true
    },
    "price_last_updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "sold_out": {
      "type": "boolean",
      "default": false
    },
    "available_days": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "available_from_time": {
      "type": "string"
    },
    "available_until_time": {
      "type": "string"
    },
    "daily_capacity": {
      "type": "number"
    },
    "delivery_fee_override": {
      "type": "number"
    },
    "minimum_order_override": {
      "type": "number"
    },
    "free_delivery_threshold_override": {
      "type": "number"
    },
    "restaurant_category_name": {
      "type": "string"
    },
    "restaurant_subcategory_name": {
      "type": "string"
    },
    "menu_section_name": {
      "type": "string"
    },
    "display_order": {
      "type": "number",
      "default": 0
    },
    "mapping_status": {
      "type": "string",
      "enum": [
        "unmapped",
        "suggested",
        "mapped",
        "needs_review",
        "rejected"
      ],
      "default": "unmapped"
    },
    "mapping_confidence": {
      "type": "number"
    },
    "mapped_by": {
      "type": "string"
    },
    "mapped_at": {
      "type": "string",
      "format": "date-time"
    },
    "import_batch_id": {
      "type": "string"
    },
    "external_id": {
      "type": "string"
    }
  },
  "required": [
    "restaurant_id",
    "price"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}