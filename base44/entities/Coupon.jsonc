{
  "name": "Coupon",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "title": "\u0643\u0648\u062f \u0627\u0644\u0643\u0648\u0628\u0648\u0646"
    },
    "type": {
      "type": "string",
      "enum": [
        "percent",
        "fixed",
        "free_delivery",
        "package"
      ],
      "default": "fixed",
      "title": "\u0646\u0648\u0639 \u0627\u0644\u062e\u0635\u0645"
    },
    "value": {
      "type": "number",
      "title": "\u0642\u064a\u0645\u0629 \u0627\u0644\u062e\u0635\u0645 (\u0646\u0633\u0628\u0629 % \u0623\u0648 \u20aa)"
    },
    "min_order": {
      "type": "number",
      "default": 0,
      "title": "\u0623\u062f\u0646\u0649 \u0642\u064a\u0645\u0629 \u0637\u0644\u0628"
    },
    "expiry": {
      "type": "string",
      "format": "date-time",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0646\u062a\u0647\u0627\u0621 \u0627\u0644\u0635\u0644\u0627\u062d\u064a\u0629"
    },
    "scope": {
      "type": "string",
      "enum": [
        "all",
        "restaurant",
        "category",
        "tamam"
      ],
      "default": "all"
    },
    "scope_ref": {
      "type": "string",
      "title": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0646\u0637\u0627\u0642 \u0639\u0646\u062f \u0627\u0644\u062d\u0627\u062c\u0629"
    },
    "owner_user_id": {
      "type": "string",
      "title": "\u0645\u0627\u0644\u0643 \u0627\u0644\u0643\u0648\u0628\u0648\u0646 (\u0644\u0644\u0645\u0643\u0627\u0641\u0622\u062a)"
    },
    "owner_phone": {
      "type": "string",
      "title": "\u0647\u0627\u062a\u0641 \u0645\u0627\u0644\u0643 \u0627\u0644\u0643\u0648\u0628\u0648\u0646"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "used",
        "expired",
        "disabled"
      ],
      "default": "active"
    },
    "source_order_id": {
      "type": "number",
      "title": "\u0627\u0644\u0637\u0644\u0628 \u0627\u0644\u0630\u064a \u0623\u0635\u062f\u0631 \u0627\u0644\u0643\u0648\u0628\u0648\u0646"
    },
    "description_ar": {
      "type": "string",
      "title": "\u0648\u0635\u0641 \u0627\u0644\u0643\u0648\u0628\u0648\u0646"
    }
  },
  "required": [
    "code",
    "type",
    "value"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}