{
  "name": "OfferUnlock",
  "type": "object",
  "properties": {
    "deal_id": {
      "type": "string",
      "title": "GroupDeal id"
    },
    "phone": {
      "type": "string",
      "title": "\u0647\u0627\u062a\u0641 \u0627\u0644\u0639\u0645\u064a\u0644 (\u0645\u0641\u062a\u0627\u062d \u0627\u0644\u0646\u0642\u0627\u0637)"
    },
    "user_id": {
      "type": "string",
      "title": "Base44 user id (\u0627\u062e\u062a\u064a\u0627\u0631\u064a)"
    },
    "unlocked_at": {
      "type": "string",
      "format": "date-time"
    },
    "points_spent": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "deal_id",
    "phone"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}