{
  "name": "HomepageSectionItem",
  "type": "object",
  "properties": {
    "homepage_section_id": {
      "type": "string",
      "title": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0642\u0633\u0645 (HomepageSection id)"
    },
    "item_type": {
      "type": "string",
      "enum": [
        "meal",
        "restaurant",
        "category",
        "suggestion",
        "mood",
        "deal",
        "media",
        "trust_item",
        "route"
      ],
      "title": "\u0646\u0648\u0639 \u0627\u0644\u0639\u0646\u0635\u0631"
    },
    "restaurant_id": {
      "type": "number",
      "title": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0637\u0639\u0645 (Supabase)"
    },
    "meal_id": {
      "type": "number",
      "title": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0648\u062c\u0628\u0629 (Supabase menu_items)"
    },
    "suggestion_id": {
      "type": "string",
      "title": "\u0645\u0639\u0631\u0641 \u0627\u0642\u062a\u0631\u0627\u062d TAMAM (TamamSuggestionSet id)"
    },
    "deal_id": {
      "type": "string",
      "title": "\u0645\u0639\u0631\u0641 \u0639\u0631\u0636 \u062c\u0645\u0627\u0639\u064a (GroupDeal id)"
    },
    "category_id": {
      "type": "string",
      "title": "\u0645\u0639\u0631\u0641 \u062a\u0635\u0646\u064a\u0641"
    },
    "media_id": {
      "type": "string",
      "title": "\u0645\u0639\u0631\u0641 \u0648\u0633\u0627\u0626\u0637 (HomepageMedia id)"
    },
    "route_key": {
      "type": "string",
      "title": "\u0645\u0641\u062a\u0627\u062d \u0648\u062c\u0647\u0629 \u062f\u0627\u062e\u0644\u064a\u0629 (\u0644\u0644\u0623\u0632\u0631\u0627\u0631/\u0627\u0644\u0628\u0627\u0646\u0631\u0627\u062a)"
    },
    "route_params": {
      "type": "string",
      "title": "\u0628\u0627\u0631\u0627\u0645\u062a\u0631\u0627\u062a \u0627\u0644\u0648\u062c\u0647\u0629 (JSON)"
    },
    "display_order": {
      "type": "number",
      "default": 0,
      "title": "\u062a\u0631\u062a\u064a\u0628 \u0627\u0644\u0639\u0631\u0636"
    },
    "title_override": {
      "type": "string",
      "title": "\u062a\u062c\u0627\u0648\u0632 \u0627\u0644\u0639\u0646\u0648\u0627\u0646"
    },
    "subtitle_override": {
      "type": "string",
      "title": "\u062a\u062c\u0627\u0648\u0632 \u0627\u0644\u0646\u0635 \u0627\u0644\u0645\u0633\u0627\u0639\u062f"
    },
    "enabled": {
      "type": "boolean",
      "default": true,
      "title": "\u0645\u0641\u0639\u0651\u0644"
    },
    "starts_at": {
      "type": "string",
      "format": "date-time"
    },
    "ends_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "homepage_section_id",
    "item_type"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}