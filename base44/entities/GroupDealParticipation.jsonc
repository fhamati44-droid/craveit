{
  "name": "GroupDealParticipation",
  "type": "object",
  "properties": {
    "deal_id": {
      "type": "string",
      "title": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0639\u0631\u0636"
    },
    "customer_id": {
      "type": "string",
      "title": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 (Base44)"
    },
    "guest_session_id": {
      "type": "string",
      "title": "\u0645\u0639\u0631\u0641 \u062c\u0644\u0633\u0629 \u0627\u0644\u0636\u064a\u0641"
    },
    "name": {
      "type": "string",
      "title": "\u0627\u0644\u0627\u0633\u0645"
    },
    "phone": {
      "type": "string",
      "title": "\u0631\u0642\u0645 \u0627\u0644\u0647\u0627\u062a\u0641"
    },
    "quantity": {
      "type": "number",
      "default": 1,
      "title": "\u0627\u0644\u0643\u0645\u064a\u0629"
    },
    "joined_tier_id": {
      "type": "string",
      "title": "\u0645\u0633\u062a\u0648\u0649 \u0627\u0644\u0627\u0646\u0636\u0645\u0627\u0645"
    },
    "joined_price": {
      "type": "number",
      "title": "\u0633\u0639\u0631 \u0627\u0644\u0627\u0646\u0636\u0645\u0627\u0645"
    },
    "final_tier_id": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u0633\u062a\u0648\u0649 \u0627\u0644\u0646\u0647\u0627\u0626\u064a"
    },
    "final_price": {
      "type": "number",
      "title": "\u0627\u0644\u0633\u0639\u0631 \u0627\u0644\u0646\u0647\u0627\u0626\u064a"
    },
    "payment_method": {
      "type": "string",
      "title": "\u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u062f\u0641\u0639"
    },
    "payment_status": {
      "type": "string",
      "default": "pending",
      "title": "\u062d\u0627\u0644\u0629 \u0627\u0644\u062f\u0641\u0639"
    },
    "provider_reference": {
      "type": "string",
      "title": "\u0645\u0631\u062c\u0639 \u0645\u0632\u0648\u062f \u0627\u0644\u062f\u0641\u0639"
    },
    "participation_status": {
      "type": "string",
      "enum": [
        "joined",
        "finalized",
        "cancelled",
        "refunded"
      ],
      "default": "joined",
      "title": "\u062d\u0627\u0644\u0629 \u0627\u0644\u0645\u0634\u0627\u0631\u0643\u0629"
    },
    "joined_at": {
      "type": "string",
      "format": "date-time"
    },
    "finalized_at": {
      "type": "string",
      "format": "date-time"
    },
    "cancelled_at": {
      "type": "string",
      "format": "date-time"
    },
    "order_id": {
      "type": "number",
      "title": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0637\u0644\u0628 \u0627\u0644\u0646\u0627\u062a\u062c (Supabase)"
    }
  },
  "required": [
    "deal_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}