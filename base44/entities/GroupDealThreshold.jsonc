{
  "name": "GroupDealThreshold",
  "type": "object",
  "properties": {
    "deal_id": {
      "type": "string",
      "title": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0639\u0631\u0636 (GroupDeal id)"
    },
    "min_participants": {
      "type": "number",
      "title": "\u0623\u062f\u0646\u0649 \u0639\u062f\u062f \u0645\u0634\u062a\u0631\u0643\u064a\u0646"
    },
    "max_participants": {
      "type": "number",
      "title": "\u0623\u0642\u0635\u0649 \u0639\u062f\u062f \u0645\u0634\u062a\u0631\u0643\u064a\u0646 (\u0627\u062e\u062a\u064a\u0627\u0631\u064a)"
    },
    "min_quantity": {
      "type": "number",
      "title": "\u0623\u062f\u0646\u0649 \u0643\u0645\u064a\u0629 (\u0639\u0646\u062f \u0627\u062d\u062a\u0633\u0627\u0628 \u0627\u0644\u0643\u0645\u064a\u0629)"
    },
    "price": {
      "type": "number",
      "title": "\u0633\u0639\u0631 \u0627\u0644\u0645\u0633\u062a\u0648\u0649 (\u20aa)"
    },
    "discount_percentage": {
      "type": "number",
      "title": "\u0646\u0633\u0628\u0629 \u0627\u0644\u062e\u0635\u0645 %"
    },
    "label": {
      "type": "string",
      "title": "\u062a\u0633\u0645\u064a\u0629 \u0644\u0644\u0639\u0645\u064a\u0644"
    },
    "is_success_threshold": {
      "type": "boolean",
      "default": false,
      "title": "\u062d\u062f \u0627\u0644\u0646\u062c\u0627\u062d \u0627\u0644\u0623\u062f\u0646\u0649"
    },
    "is_best_tier": {
      "type": "boolean",
      "default": false,
      "title": "\u0623\u0641\u0636\u0644 \u0645\u0633\u062a\u0648\u0649/\u0646\u0647\u0627\u0626\u064a"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "title": "\u062a\u0631\u062a\u064a\u0628 \u0627\u0644\u0639\u0631\u0636"
    }
  },
  "required": [
    "deal_id",
    "min_participants",
    "price"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
