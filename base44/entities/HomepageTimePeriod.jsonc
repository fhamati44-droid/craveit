{
  "name": "HomepageTimePeriod",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u0641\u062a\u0627\u062d (early_morning, lunch, ...)"
    },
    "name_ar": {
      "type": "string",
      "title": "\u0627\u0644\u0627\u0633\u0645 (\u0639\u0631\u0628\u064a)"
    },
    "name_he": {
      "type": "string",
      "title": "\u0627\u0644\u0627\u0633\u0645 (\u0639\u0628\u0631\u064a)"
    },
    "start_time": {
      "type": "string",
      "title": "\u0648\u0642\u062a \u0627\u0644\u0628\u062f\u0627\u064a\u0629 (HH:MM)"
    },
    "end_time": {
      "type": "string",
      "title": "\u0648\u0642\u062a \u0627\u0644\u0646\u0647\u0627\u064a\u0629 (HH:MM)"
    },
    "weekdays": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "default": [
        0,
        1,
        2,
        3,
        4,
        5,
        6
      ],
      "title": "\u0623\u064a\u0627\u0645 \u0627\u0644\u0623\u0633\u0628\u0648\u0639 (0=\u0623\u062d\u062f)"
    },
    "priority": {
      "type": "number",
      "default": 0,
      "title": "\u0627\u0644\u0623\u0648\u0644\u0648\u064a\u0629"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "title": "\u0645\u0641\u0639\u0651\u0644"
    },
    "is_fallback": {
      "type": "boolean",
      "default": false,
      "title": "\u0641\u062a\u0631\u0629 \u0627\u062d\u062a\u064a\u0627\u0637\u064a\u0629"
    },
    "timezone": {
      "type": "string",
      "default": "Asia/Jerusalem",
      "title": "\u0627\u0644\u0645\u0646\u0637\u0642\u0629 \u0627\u0644\u0632\u0645\u0646\u064a\u0629"
    },
    "recommended_moods": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "\u0645\u0648\u062f\u0627\u062a \u0645\u0642\u062a\u0631\u062d\u0629 (slug \u0623\u0648 id)"
    },
    "recommended_categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "\u062a\u0635\u0646\u064a\u0641\u0627\u062a \u0645\u0642\u062a\u0631\u062d\u0629"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "title": "\u062a\u0631\u062a\u064a\u0628 \u0627\u0644\u0639\u0631\u0636"
    }
  },
  "required": [
    "key",
    "name_ar",
    "start_time",
    "end_time"
  ],
  "rls": {
