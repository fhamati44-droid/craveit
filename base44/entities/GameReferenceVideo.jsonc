{
  "name": "GameReferenceVideo",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Internal title"
    },
    "internal_notes": {
      "type": "string",
      "title": "Design notes"
    },
    "reference_type": {
      "type": "string",
      "enum": [
        "camera",
        "hand_interaction",
        "table_transformation",
        "food_movement",
        "social_reaction",
        "lighting",
        "final_scene"
      ],
      "default": "camera"
    },
    "file_url": {
      "type": "string",
      "title": "Original reference video URL"
    },
    "poster_image_url": {
      "type": "string",
      "title": "Thumbnail/poster"
    },
    "is_enabled": {
      "type": "boolean",
      "default": true
    },
    "priority": {
      "type": "number",
      "default": 0
    },
    "is_public_preview": {
      "type": "boolean",
      "default": false,
      "title": "Approved for public homepage preview"
    },
    "public_preview_url": {
      "type": "string",
      "title": "Optimized public copy (mobile MP4/WebM)"
    },
    "public_poster_url": {
      "type": "string",
      "title": "Public poster image"
    }
  },
  "required": [
    "title",
    "file_url",
    "reference_type"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}