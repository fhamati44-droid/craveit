{
  "name": "DemandTemporaryOverride",
  "type": "object",
  "properties": {
    "restaurant_id": {
      "type": "string"
    },
    "branch_id": {
      "type": "string"
    },
    "start_at": {
      "type": "string",
      "format": "date-time"
    },
    "end_at": {
      "type": "string",
      "format": "date-time"
    },
    "demand_level": {
      "type": "string",
      "enum": [
        "quiet",
        "medium",
        "busy",
        "unknown"
      ]
    },
    "operational_effect": {
      "type": "string",
      "enum": [
        "information_only",
        "reduce_campaigns",
        "pause_campaigns",
        "stop_new_orders"
      ],
      "default": "information_only"
    },
    "source": {
      "type": "string",
      "enum": [
        "merchant",
        "restaurant_manager",
        "tamam_admin",
        "system"
      ],
      "default": "merchant"
    },
    "created_by_user_id": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "is_demo": {
      "type": "boolean",
      "default": false,
      "title": "Demo record flag"
    },
    "demo_batch_id": {
      "type": "string",
      "title": "Demo batch id"
    }
  },
  "required": [
    "restaurant_id",
    "start_at",
    "demand_level"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}