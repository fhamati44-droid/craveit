{
  "name": "RestaurantMenu",
  "type": "object",
  "properties": {
    "restaurant_id": {
      "type": "string",
      "title": "Restaurant (Base44 id)"
    },
    "name_ar": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0645\u064a\u0646\u064a\u0648 (\u0639\u0631\u0628\u064a)"
    },
    "internal_name": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "currency": {
      "type": "string",
      "default": "ILS"
    },
    "menu_type": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "default": 1
    },
    "import_source": {
      "type": "string"
    },
    "last_import_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "restaurant_id"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}