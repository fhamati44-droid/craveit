{
  "name": "HomepageVersion",
  "type": "object",
  "properties": {
    "version_number": {
      "type": "number",
      "title": "\u0631\u0642\u0645 \u0627\u0644\u0646\u0633\u062e\u0629"
    },
    "label": {
      "type": "string",
      "title": "\u062a\u0633\u0645\u064a\u0629 \u0627\u0644\u0646\u0633\u062e\u0629"
    },
    "snapshot_json": {
      "type": "string",
      "title": "\u0644\u0642\u0637\u0629 \u0643\u0627\u0645\u0644\u0629 (JSON) \u0644\u0643\u0644 \u0627\u0644\u0623\u0642\u0633\u0627\u0645 \u0648\u0627\u0644\u0639\u0646\u0627\u0635\u0631"
    },
    "is_active": {
      "type": "boolean",
      "default": false,
      "title": "\u0647\u064a \u0627\u0644\u0646\u0633\u062e\u0629 \u0627\u0644\u0645\u0646\u0634\u0648\u0631\u0629 \u0627\u0644\u062d\u0627\u0644\u064a\u0629"
    },
    "published_by_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0646\u0627\u0634\u0631"
    },
    "published_by_id": {
      "type": "string",
      "title": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0646\u0627\u0634\u0631"
    },
    "change_summary": {
      "type": "string",
      "title": "\u0645\u0644\u062e\u0635 \u0627\u0644\u062a\u063a\u064a\u064a\u0631\u0627\u062a"
    },
    "is_rollback": {
      "type": "boolean",
      "default": false,
      "title": "\u0646\u0633\u062e\u0629 \u0627\u0633\u062a\u0631\u062c\u0627\u0639"
    }
  },
  "required": [
    "version_number",
    "snapshot_json"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}