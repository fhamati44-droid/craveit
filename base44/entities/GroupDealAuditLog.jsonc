{
  "name": "GroupDealAuditLog",
  "type": "object",
  "properties": {
    "deal_id": {
      "type": "string",
      "title": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0639\u0631\u0636"
    },
    "deal_title": {
      "type": "string",
      "title": "\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0639\u0631\u0636 (\u0644\u0644\u0642\u0637\u0629)"
    },
    "action": {
      "type": "string",
      "enum": [
        "created",
        "edited",
        "threshold_changed",
        "published",
        "paused",
        "resumed",
        "cancelled",
        "end_extended",
        "finalized",
        "refund_initiated",
        "duplicated",
        "archived"
      ],
      "title": "\u0627\u0644\u0625\u062c\u0631\u0627\u0621"
    },
    "admin_id": {
      "type": "string",
      "title": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0634\u0631\u0641"
    },
    "admin_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0634\u0631\u0641"
    },
    "previous_value": {
      "type": "string",
      "title": "\u0627\u0644\u0642\u064a\u0645\u0629 \u0627\u0644\u0633\u0627\u0628\u0642\u0629"
    },
    "new_value": {
      "type": "string",
      "title": "\u0627\u0644\u0642\u064a\u0645\u0629 \u0627\u0644\u062c\u062f\u064a\u062f\u0629"
    },
    "reason": {
      "type": "string",
      "title": "\u0627\u0644\u0633\u0628\u0628 (\u0639\u0646\u062f \u0627\u0644\u062d\u0627\u062c\u0629)"
    }
  },
  "required": [
    "deal_id",
    "action"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}