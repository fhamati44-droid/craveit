{
  "name": "MenuImportCandidate",
  "type": "object",
  "properties": {
    "menu_import_session_id": {
      "type": "string",
      "title": "MenuImportSession id"
    },
    "restaurant_id": {
      "type": "string",
      "title": "Restaurant (Base44 id) \u2014 denormalized for fast per-restaurant queries"
    },
    "branch_id": {
      "type": "string"
    },
    "source_reference": {
      "type": "string",
      "title": "\u0645\u0631\u062c\u0639 \u0627\u0644\u0645\u0635\u062f\u0631 (catalog product id / template / branch / row)"
    },
    "detected_name": {
      "type": "string",
      "title": "\u0627\u0644\u0627\u0633\u0645 \u0627\u0644\u0639\u0627\u0645 \u0627\u0644\u0645\u0643\u062a\u0634\u0641"
    },
    "normalized_name": {
      "type": "string"
    },
    "detected_description": {
      "type": "string"
    },
    "detected_price": {
      "type": "number"
    },
    "detected_category": {
      "type": "string"
    },
    "detected_image": {
      "type": "string"
    },
    "mapped_master_catalog_product_id": {
      "type": "number",
      "title": "TAMAM Master Catalog product id (Supabase menu_items)"
    },
    "mapping_confidence": {
      "type": "number"
    },
    "duplicate_restaurant_menu_item_id": {
      "type": "string",
      "title": "RestaurantMealOffer id \u0627\u0644\u0645\u0637\u0627\u0628\u0642"
    },
    "duplicate_status": {
      "type": "string",
      "enum": [
        "none",
        "exact",
        "likely",
        "unresolved"
      ],
      "default": "none",
      "title": "\u062d\u0627\u0644\u0629 \u0627\u0644\u062a\u0643\u0631\u0627\u0631"
    },
    "rights_status": {
      "type": "string",
      "enum": [
        "approved",
        "pending",
        "rejected",
        "unknown"
      ],
      "default": "unknown",
      "title": "\u062d\u0627\u0644\u0629 \u062d\u0642\u0648\u0642 \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645"
    },
    "review_status": {
      "type": "string",
      "enum": [
        "needs_review",
        "ready",
        "excluded",
        "imported",
        "failed"
      ],
      "default": "needs_review",
      "title": "\u062d\u0627\u0644\u0629 \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629"
    },
    "user_changes": {
      "type": "string",
      "title": "JSON: \u062a\u0639\u062f\u064a\u0644\u0627\u062a \u0635\u0627\u062d\u0628 \u0627\u0644\u0645\u0637\u0639\u0645 (name, price, description, image, available, prep_time, category, campaign_permission, max_daily_quantity, duplicate_decision)"
    },
    "image_source_type": {
      "type": "string",
      "enum": [
        "restaurant_owned",
        "tamam_owned",
        "licensed_partner",
        "stock_licensed",
        "user_uploaded",
        "unknown"
      ],
      "default": "unknown"
    },
    "image_source_reference": {
      "type": "string"
    },
    "usage_permission_status": {
      "type": "string",
      "enum": [
        "approved",
        "pending",
        "rejected",
        "unknown"
      ],
      "default": "unknown"
    },
    "missing_fields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "\u062d\u0642\u0648\u0644 \u0646\u0627\u0642\u0635\u0629"
    }
  },
  "required": [
    "menu_import_session_id",
    "restaurant_id",
    "review_status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}