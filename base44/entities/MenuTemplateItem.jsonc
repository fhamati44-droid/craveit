{
  "name": "MenuTemplateItem",
  "type": "object",
  "properties": {
    "menu_template_id": {
      "type": "string",
      "title": "MenuTemplate id"
    },
    "tamam_master_catalog_product_id": {
      "type": "number",
      "title": "TAMAM Master Catalog product id (Supabase menu_items)"
    },
    "default_category_id": {
      "type": "number"
    },
    "default_category_name": {
      "type": "string"
    },
    "display_order": {
      "type": "number",
      "default": 0
    },
    "generic_name_ar": {
      "type": "string"
    },
    "generic_description_ar": {
      "type": "string"
    },
    "approved_image_id": {
      "type": "string"
    },
    "approved_image_url": {
      "type": "string"
    },
    "is_optional": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "menu_template_id",
    "tamam_master_catalog_product_id"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}