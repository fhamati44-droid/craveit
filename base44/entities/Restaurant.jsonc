{
  "name": "Restaurant",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Name"
    },
    "name_ar": {
      "type": "string",
      "title": "Arabic name"
    },
    "logo_url": {
      "type": "string",
      "title": "Logo image URL"
    },
    "cover_image_url": {
      "type": "string",
      "title": "Cover image URL"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "phone": {
      "type": "string"
    },
    "whatsapp": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "verified": {
      "type": "boolean",
      "default": false
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "rating": {
      "type": "number"
    },
    "minimum_order": {
      "type": "number",
      "default": 0
    },
    "delivery_fee": {
      "type": "number",
      "default": 0
    },
    "free_delivery_threshold": {
      "type": "number"
    },
    "preparation_time_min": {
      "type": "number"
    },
    "preparation_time_max": {
      "type": "number"
    },
    "delivery_time_min": {
      "type": "number"
    },
    "delivery_time_max": {
      "type": "number"
    },
    "accepts_orders": {
      "type": "boolean",
      "default": true
    },
    "current_status": {
      "type": "string",
      "enum": [
        "open",
        "closed",
        "busy",
        "temporarily_unavailable"
      ],
      "default": "open"
    },
    "menu_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Assigned menu/category ids"
    },
    "supabase_restaurant_id": {
      "type": "number",
      "title": "Linked Supabase restaurant id (optional)"
    },
    "capacity_normal_additional_per_hour": {
      "type": "number",
      "title": "Partner-provided: typical extra orders/hour absorbable in a quiet period"
    },
    "capacity_max_additional_per_hour": {
      "type": "number",
      "title": "Partner-provided: short-burst max extra orders/hour (optional)"
    },
    "capacity_weak_period_additional": {
      "type": "number",
      "title": "Time-specific capacity for weak periods (optional)"
    },
    "capacity_peak_period_additional": {
      "type": "number",
      "title": "Time-specific capacity for peak periods (optional)"
    },
    "capacity_pickup": {
      "type": "number",
      "title": "Pickup capacity (optional)"
    },
    "capacity_delivery": {
      "type": "number",
      "title": "Delivery capacity (optional)"
    },
    "capacity_confidence": {
      "type": "number",
      "title": "0-1 confidence in the configured capacity (optional)"
    },
    "capacity_source": {
      "type": "string",
      "title": "Last source used to resolve capacity (set by engine)"
    },
    "primary_vertical_id": {
      "type": "string",
      "title": "Primary MenuVertical id"
    },
    "secondary_vertical_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Secondary MenuVertical ids"
    },
    "fulfillment_type": {
      "type": "string",
      "enum": [
        "ON_DEMAND_PREPARED_FOOD",
        "SCHEDULED_PREPARED_FOOD",
        "RETAIL_PICK_AND_PACK",
        "FRESH_WEIGHT_BASED",
        "PREORDER"
      ],
      "title": "How this restaurant fulfills orders"
    },
    "vertical_strategy_override_json": {
      "type": "string",
      "title": "JSON: per-restaurant overrides on vertical daypart/playbook strategy"
    },
    "is_demo": {
      "type": "boolean",
      "default": false,
      "title": "Demo record flag"
    },
    "demo_batch_id": {
      "type": "string",
      "title": "Demo batch id (set when generated by demo system)"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}