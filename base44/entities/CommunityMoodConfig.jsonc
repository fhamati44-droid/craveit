{
  "name": "CommunityMoodConfig",
  "type": "object",
  "properties": {
    "is_enabled": {
      "type": "boolean",
      "default": true
    },
    "section_title_ar": {
      "type": "string",
      "default": "\u0627\u0635\u0646\u0639 \u0645\u0648\u062f\u0643 \u0639\u0644\u0649 \u0637\u0627\u0648\u0644\u0629 TAMAM"
    },
    "section_title_he": {
      "type": "string",
      "default": "\u05e6\u05e8\u05d5 \u05d0\u05ea \u05d4\u05de\u05d5\u05d3 \u05e9\u05dc\u05db\u05dd \u05e2\u05dc \u05e9\u05d5\u05dc\u05d7\u05df TAMAM"
    },
    "section_subtitle_ar": {
      "type": "string",
      "default": "\u0627\u062e\u062a\u0627\u0631 \u0627\u0644\u0648\u062c\u0628\u0627\u062a\u060c \u0631\u062a\u0651\u0628\u0647\u0627 \u0628\u0637\u0631\u064a\u0642\u062a\u0643\u060c \u0648\u0627\u0646\u0634\u0631 \u0627\u0644\u0645\u0648\u062f \u062d\u062a\u0649 \u0627\u0644\u0646\u0627\u0633 \u062a\u062f\u0639\u0645\u0647."
    },
    "section_subtitle_he": {
      "type": "string",
      "default": "\u05d1\u05d5\u05d7\u05e8\u05d9\u05dd \u05de\u05e0\u05d5\u05ea, \u05de\u05e1\u05d3\u05e8\u05d9\u05dd \u05d0\u05ea \u05d4\u05de\u05d5\u05d3 \u05d5\u05de\u05e9\u05ea\u05e4\u05d9\u05dd \u05db\u05d3\u05d9 \u05e9\u05d4\u05e7\u05d4\u05d9\u05dc\u05d4 \u05ea\u05ea\u05de\u05d5\u05da."
    },
    "cta_primary_ar": {
      "type": "string",
      "default": "\u0627\u0628\u062f\u0623 \u0627\u0644\u0644\u0639\u0628\u0629"
    },
    "cta_primary_he": {
      "type": "string",
      "default": "\u05d4\u05ea\u05d7\u05d9\u05dc\u05d5 \u05dc\u05e9\u05d7\u05e7"
    },
    "cta_secondary_ar": {
      "type": "string",
      "default": "\u0634\u0648\u0641 \u0645\u0648\u062f\u0627\u062a \u0627\u0644\u0646\u0627\u0633"
    },
    "cta_secondary_he": {
      "type": "string",
      "default": "\u05e6\u05e4\u05d5 \u05d1\u05de\u05d5\u05d3\u05d9\u05dd \u05e9\u05dc \u05d4\u05e7\u05d4\u05d9\u05dc\u05d4"
    },
    "banner_poster_url": {
      "type": "string",
      "title": "Banner poster image"
    },
    "preview_media_url": {
      "type": "string",
      "title": "Preview video/animated media URL"
    },
    "preview_poster_url": {
      "type": "string",
      "title": "Preview poster (fallback)"
    },
    "selection_mode": {
      "type": "string",
      "enum": [
        "automatic",
        "manual"
      ],
      "default": "automatic"
    },
    "manual_proposal_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "max_cards": {
      "type": "number",
      "default": 6
    },
    "default_target_likes": {
      "type": "number",
      "default": 100
    },
    "multi_restaurant_enabled": {
      "type": "boolean",
      "default": false
    },
    "trusted_user_auto_publish": {
      "type": "boolean",
      "default": false
    },
    "avatar_profile_image_enabled": {
      "type": "boolean",
      "default": false
    },
    "max_comments_preview": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "section_title_ar"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}