{
  "name": "AutomationControl",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "title": "Singleton key (always 'global')"
    },
    "paused": {
      "type": "boolean",
      "default": false,
      "title": "Global kill switch \u2014 pauses new guarded auto-activations (never cancels paid orders)"
    },
    "reason": {
      "type": "string"
    },
    "paused_by": {
      "type": "string"
    },
    "paused_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "key"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}